# --- Site (build time) --------------------------------------------------------
# Public URL of the finished site. Used for share links, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3200
NEXT_PUBLIC_SITE_NAME=Tippetuppen
# "/tippetuppen" when served from <user>.github.io/tippetuppen; empty on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# --- Game API (build time) ----------------------------------------------------
# The Supabase Edge Function that holds the game logic and the answers.
# Production: https://<project-ref>.supabase.co/functions/v1/api
# Local dev:  http://localhost:8000/api  (see `npm run dev:stack`)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Public anon key from Supabase → Settings → API. Safe to publish.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Ads (build time) ---------------------------------------------------------
# Leave empty to render mock placeholders. Set the publisher id (ca-pub-...) to go live.
# Setting it also generates public/ads.txt during the build.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_ARCHIVE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# "funding-choices" loads Google's certified CMP, required for personalised ads in the EEA.
NEXT_PUBLIC_CMP=

# --- Data tooling (local scripts and GitHub Actions only) ---------------------
# Postgres connection string, used by db:migrate / db:seed / data:schedule.
# Never needed by the website itself. Leave empty locally to use embedded PGlite.
DATABASE_URL=

# --- Edge Function secrets (set with `supabase secrets set`, never in the build) ---
# SUPABASE_DB_URL is provided by Supabase automatically.
# ADMIN_KEY        long random string; unlocks the admin routes and the /admin page
# ANALYTICS_SALT   random string for the daily anonymous visitor hash
