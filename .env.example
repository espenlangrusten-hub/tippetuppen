# --- Database ---------------------------------------------------------------
# Leave empty locally: the app uses an embedded PGlite Postgres in .data/pglite.
# In production, set a Postgres connection string (Supabase "Transaction pooler" URL works).
DATABASE_URL=

# --- Site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Tippetuppen

# --- Admin ---------------------------------------------------------------------
# Required to open /admin. Use a long random password.
ADMIN_PASSWORD=
# Random 32+ char secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET=

# --- Analytics -------------------------------------------------------------------
# Salt for the daily-rotating anonymous visitor hash (no cookies). Any random string.
ANALYTICS_SALT=change-me

# --- Ads (Google AdSense) ----------------------------------------------------------
# Leave empty to render mock placeholders. Set the publisher id (ca-pub-...) to go live.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional per-placement ad unit ids (data-ad-slot). Missing ids fall back to auto ads off.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_ARCHIVE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Consent: "funding-choices" loads Google's certified CMP (Privacy & messaging in AdSense).
# Anything else keeps ads in non-personalised/limited mode with the built-in banner.
NEXT_PUBLIC_CMP=
